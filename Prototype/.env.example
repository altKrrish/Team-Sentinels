# Point the UI at your SIF classification model.
# Copy to `.env.local` and set VITE_USE_MOCK=false when your endpoint is live.

# When true (default), the UI runs entirely on bundled demo fixtures.
VITE_USE_MOCK=true

# Base URL of your model service. The UI calls:
#   GET  {VITE_API_BASE}/reports              -> Report[]
#   POST {VITE_API_BASE}/classify             -> { text } => Report-shaped object
#   POST {VITE_API_BASE}/reports/:id/review   -> { state, note } => Review
VITE_API_BASE=http://localhost:8000
